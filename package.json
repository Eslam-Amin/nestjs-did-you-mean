{
  "name": "nestjs-did-you-mean",
  "version": "1.0.2",
  "description": "Production-ready, zero-dependency 404 Route Suggester for NestJS with Express and Fastify support",
  "author": "Eslam Amin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eslam-Amin/nestjs-did-you-mean.git"
  },
  "homepage": "https://github.com/Eslam-Amin/nestjs-did-you-mean#readme",
  "bugs": {
    "url": "https://github.com/Eslam-Amin/nestjs-did-you-mean/issues"
  },
  "license": "MIT",
  "keywords": [
    "nestjs",
    "404",
    "route-suggester",
    "did-you-mean",
    "fuzzy-matching",
    "fastify",
    "express",
    "swagger",
    "openapi",
    "exception-filter",
    "developer-experience"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "@nestjs/common": ">=9.0.0",
    "@nestjs/core": ">=9.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/platform-express": {
      "optional": true
    },
    "@nestjs/platform-fastify": {
      "optional": true
    },
    "@nestjs/swagger": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/testing": "^10.4.22",
    "@swc/core": "^1.16.18",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.8",
    "express": "^4.21.2",
    "fastify": "^4.28.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^2.1.8"
  }
}
